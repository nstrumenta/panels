{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    /* Linting */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022",
      "webworker"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useUnknownInCatchVariables": false,
    "baseUrl": "./src",
    "paths": {
      "@base": [
        "."
      ],
      "@base/*": [
        "./*"
      ],
      "@foxglove/hooks": [
        "./hooks"
      ],
      "@foxglove/log": [
        "./log"
      ],
      "@foxglove/studio": [
        "./studio"
      ]
    },
    "types": [],
  },
  "include": [
    "src/**/*",
    "global.d.ts",
  ],
  "exclude": [
    "node_modules"
  ]
}